{
  "name": "kraftvaerk.umbraco.blockfilter.extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite build --watch",
    "generate": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 npx openapi-typescript-codegen --input https://localhost:44338/openapi/blockfilter-api-v1.json --output ./src/blockfilter-api --client fetch --name BlockfilterClient --useOptions",
    "skills:copilot": "npx skills add umbraco/Umbraco-CMS-Backoffice-Skills --skill * -a github-copilot",
    "skills:cursor": "npx skills add umbraco/Umbraco-CMS-Backoffice-Skills --skill * -a cursor",
    "skills:windsurf": "npx skills add umbraco/Umbraco-CMS-Backoffice-Skills --skill * -a windsurf",
    "skills:claude": "npx skills add umbraco/Umbraco-CMS-Backoffice-Skills --skill * -a claude"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "lit": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "@umbraco-cms/backoffice": "^18.0.0-rc1",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "openapi-typescript-codegen": "^0.29.0"
  }
}

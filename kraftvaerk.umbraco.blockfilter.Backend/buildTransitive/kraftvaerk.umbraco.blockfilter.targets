<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!-- Earlier versions copied the UI into the site's wwwroot. Keep leftovers out of the build so they don't clash with the static web assets from this package. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\App_Plugins\kraftvaerk.umbraco.blockfilter.frontend\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<UmbracoJsonSchemaFiles Include="$(MSBuildThisFileDirectory)..\appsettings-schema.blockfilter.json" />
	</ItemGroup>
</Project>
